{
  "sections": {
    "film_titre": {
      "type": "section",
      "blocks": {
        "titre": {
          "type": "text",
          "name": "t:names.heading",
          "settings": {
            "text": "<h2>FILMS</h2>",
            "width": "fit-content",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "h2",
            "font": "var(--font-heading--family)",
            "font_size": "",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "color": "var(--color-foreground-heading)",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 24,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "separateur": {
          "type": "_divider",
          "name": "t:names.divider",
          "settings": {
            "thickness": 1,
            "corner_radius": "square",
            "width_percent": 5,
            "alignment_horizontal": "center",
            "padding-block-start": 0,
            "padding-block-end": 0
          },
          "blocks": {}
        }
      },
      "block_order": [
        "titre",
        "separateur"
      ],
      "custom_css": [],
      "name": "Titre – Films",
      "settings": {
        "content_direction": "column",
        "vertical_on_mobile": true,
        "horizontal_alignment": "flex-start",
        "vertical_alignment": "center",
        "align_baseline": false,
        "horizontal_alignment_flex_direction_column": "center",
        "vertical_alignment_flex_direction_column": "flex-start",
        "gap": 10,
        "section_width": "page-width",
        "section_height": "custom",
        "section_height_custom": 15,
        "color_scheme": "",
        "background_media": "none",
        "video_position": "cover",
        "background_image_position": "cover",
        "border": "none",
        "border_width": 1,
        "border_opacity": 100,
        "border_radius": 0,
        "toggle_overlay": false,
        "overlay_color": "#00000026",
        "overlay_style": "solid",
        "gradient_direction": "to top",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "film_sous_titre": {
      "type": "section",
      "blocks": {
        "sous_titre": {
          "type": "text",
          "name": "Titre du film (auto)",
          "settings": {
            "text": "<p>{{ article.title }}</p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "custom",
            "font": "var(--font-body--family)",
            "font_size": "1.5rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "uppercase",
            "wrap": "pretty",
            "color": "var(--color-primary)",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        }
      },
      "block_order": [
        "sous_titre"
      ],
      "name": "Titre du film",
      "settings": {
        "content_direction": "column",
        "vertical_on_mobile": true,
        "horizontal_alignment": "flex-start",
        "vertical_alignment": "center",
        "align_baseline": false,
        "horizontal_alignment_flex_direction_column": "center",
        "vertical_alignment_flex_direction_column": "center",
        "gap": 25,
        "section_width": "page-width",
        "section_height": "",
        "section_height_custom": 50,
        "color_scheme": "scheme-1",
        "background_media": "none",
        "video_position": "cover",
        "background_image_position": "cover",
        "border": "none",
        "border_width": 1,
        "border_opacity": 100,
        "border_radius": 0,
        "toggle_overlay": false,
        "overlay_color": "#00000026",
        "overlay_style": "solid",
        "gradient_direction": "to top",
        "padding-block-start": 8,
        "padding-block-end": 8
      }
    },
    "section": {
      "type": "main-blog-post",
      "blocks": {
        "filet": {
          "type": "custom-liquid",
          "name": "Filet",
          "settings": {
            "custom_liquid": "<hr class=\"mf-portrait-hr\">"
          },
          "blocks": {}
        },
        "lien_tous": {
          "type": "text",
          "name": "Lien – Tous les films",
          "settings": {
            "text": "<p><a href=\"/blogs/films\">TOUS LES FILMS</a></p>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "center",
            "type_preset": "rte",
            "font": "var(--font-body--family)",
            "font_size": "0.75rem",
            "line_height": "normal",
            "letter_spacing": "loose",
            "case": "uppercase",
            "wrap": "pretty",
            "color": "var(--color-primary)",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "blog-post-title": {
          "type": "text",
          "name": "Title",
          "disabled": true,
          "static": true,
          "settings": {
            "text": "<h1>{{ article.title }}</h1>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h2",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "color": "var(--color-foreground)",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "blog-post-details": {
          "type": "_blog-post-info-text",
          "name": "Details",
          "disabled": true,
          "static": true,
          "settings": {
            "show_date": false,
            "show_author": false,
            "type_preset": "",
            "alignment": "left",
            "show_alignment": true,
            "padding-block-start": 0,
            "padding-block-end": 0
          },
          "blocks": {}
        },
        "blog-post-image": {
          "type": "_blog-post-featured-image",
          "disabled": true,
          "static": true,
          "settings": {
            "image_ratio": "adapt",
            "width": "fill",
            "custom_width": 100,
            "width_mobile": "fill",
            "custom_width_mobile": 100,
            "height": "fit",
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "blog-post-content": {
          "type": "_blog-post-content",
          "static": true,
          "settings": {},
          "blocks": {}
        },
        "styles_video": {
          "type": "custom-liquid",
          "name": "Styles vidéo",
          "settings": {
            "custom_liquid": "<style>\n  .blog-post-content iframe, .blog-post-content video { display:block; width:100%; max-width:100%; aspect-ratio:16/9; height:auto; margin:0 auto 24px; }\n  .blog-post-content { max-width: var(--page-width); margin: 0 auto; }\n  .mf-portrait-hr { max-width: var(--normal-content-width); margin: 0 auto; border:0; border-top:1px solid #1B2E49; opacity:.25; }\n</style>"
          },
          "blocks": {}
        }
      },
      "block_order": [
        "styles_video",
        "filet",
        "lien_tous"
      ],
      "settings": {
        "content_direction": "column",
        "gap": 20,
        "color_scheme": "scheme-1",
        "padding-block-start": 8,
        "padding-block-end": 100
      }
    }
  },
  "order": [
    "film_titre",
    "film_sous_titre",
    "section"
  ]
}
